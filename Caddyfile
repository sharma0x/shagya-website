# Global options
{
    # Browsers do not send SNI for IP-literal URLs, so serve the IP site
    # (self-signed via tls internal) when no SNI is provided.
    # PUBLIC_IP is injected from the environment (see docker-compose.prod.yml / .env).
    default_sni {$PUBLIC_IP}
}

# Shared upstream config for the Next.js / Payload containers
(shayga_app) {
    # Fast modern compression (zstd, gzip)
    encode zstd gzip

    # Reverse proxy to the Payload / Next.js container(s)
    reverse_proxy app:3000 {
        # Forward Cloudflare client IP if available, fallback to remote host
        header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
        header_up X-Real-IP {http.request.header.CF-Connecting-IP}
        header_up Host {host}
        header_up X-Forwarded-Proto {scheme}

        # Health checks and load balancing across replicas
        lb_policy round_robin
        lb_try_duration 5s
        lb_try_interval 250ms
    }

    # Production JSON access logs
    log {
        output file /var/log/caddy/access.log {
            roll_size 20mb
            roll_keep 5
        }
        format json
    }
}

# Public domain (Let's Encrypt via Cloudflare)
{$DOMAIN_NAME:shayga.in}, www.{$DOMAIN_NAME:shayga.in} {
    import shayga_app
}

# Direct access via the Elastic IP (PUBLIC_IP env var).
# Public CAs (Let's Encrypt) do not issue certs for bare IPs, so Caddy serves
# a self-signed cert here. Expect a browser certificate warning and proceed.
https://{$PUBLIC_IP} {
    tls internal
    import shayga_app
}
