# =============================================================================
# Shayga — Staging Environment (.env.staging)
# =============================================================================
# Copy to `.env.staging` (next to docker-compose.staging.yml) and fill in.
# Served at http://shayga.localhost (add `127.0.0.1 shayga.localhost` to /etc/hosts).

# --- Server ---
# Runtime source of truth for the server URL. NEXT_PUBLIC_SERVER_URL is baked
# into the image at build time, so PAYLOAD_PUBLIC_SERVER_URL is what the running
# container reads (see src/lib/env.ts getServerURL()).
PAYLOAD_PUBLIC_SERVER_URL=http://shayga.localhost

# --- Database (local Docker Postgres) ---
DATABASE_URL=postgresql://shayga:shayga_dev@postgres:5432/shayga

# --- Payload ---
PAYLOAD_SECRET=change-me-32-chars-minimum-length

# --- Authentication (Better Auth) ---
BETTER_AUTH_SECRET=change-me-32-chars-minimum-length

# --- Storage (Cloudflare R2 — dev bucket) ---
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=shayga-media-dev
R2_REGION=auto

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM_NAME=Shayga
EMAIL_FROM_ADDRESS=orders@shayga.in

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Firebase Authentication (Phone OTP, Google, Email/Password) ---
# Get these from Firebase Console → Project Settings → General
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# Firebase Admin SDK (Server-side)
# Get from Firebase Console → Project Settings → Service Accounts
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# --- Analytics (GA4) ---
# Leave unset to disable analytics entirely (zero GA payload).
# Events are console-logged automatically in development.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-SNBZQD1552
# Debug logging/DebugView is hard-capped OFF in production builds — this flag
# only takes effect for non-production NODE_ENV.
# NEXT_PUBLIC_GA_DEBUG=true

# --- Meta Pixel ---
# Public client identifier. Do not place a Meta access token here.
NEXT_PUBLIC_FB_PIXEL_ID=936721776173959

# --- Allowed origins (CORS/CSRF/trustedOrigins) ---
EXTRA_ALLOWED_ORIGINS=http://shayga.localhost

# --- Delhivery One (fulfilment) ---
# test → staging-express.delhivery.com · prod → track.delhivery.com
DELHIVERY_MODE=
# Token from Delhivery One → Settings → API Setup → Existing API Token
DELHIVERY_API_TOKEN=
# Warehouse name EXACTLY as registered on Delhivery (case/space sensitive)
# Warehouse pincode (used for return pin / seller pin on manifests)
# Client name used by Delhivery One API calls
# Seller identity stamped on manifests
# Shared secret for webhook signature verification (header: x-delhivery-signature)
# Pickup location, client name and seller identity are managed in
# Site Settings → Delhivery Shipping (no env vars needed).
DELHIVERY_WEBHOOK_SECRET=
