# =============================================================================
# Shayga — Staging Environment (.env.staging)
# =============================================================================
# Copy to `.env.staging` (next to docker-compose.staging.yml) and fill in.
# Served at http://shayga.localhost (add `127.0.0.1 shayga.localhost` to /etc/hosts).

# --- Server ---
# Runtime source of truth for the server URL. NEXT_PUBLIC_SERVER_URL is baked
# into the image at build time, so PAYLOAD_PUBLIC_SERVER_URL is what the running
# container reads (see src/lib/env.ts getServerURL()).
PAYLOAD_PUBLIC_SERVER_URL=http://shayga.localhost

# --- Database (local Docker Postgres) ---
DATABASE_URL=postgresql://shayga:shayga_dev@postgres:5432/shayga

# --- Payload ---
PAYLOAD_SECRET=change-me-32-chars-minimum-length

# --- Authentication (Better Auth) ---
BETTER_AUTH_SECRET=change-me-32-chars-minimum-length

# --- Storage (Cloudflare R2 — dev bucket) ---
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=shayga-media-dev
R2_REGION=auto

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM_NAME=Shayga
EMAIL_FROM_ADDRESS=orders@shayga.in

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Allowed origins (CORS/CSRF/trustedOrigins) ---
EXTRA_ALLOWED_ORIGINS=http://shayga.localhost
